# Copie este archivo como .env y cambie todos los valores CHANGE_ME.
# Nunca introduzca secretos reales en Git.
COMPOSE_PROJECT_NAME=oxidized-ai-manager

POSTGRES_DB=oxidized_ai
POSTGRES_USER=oxidized_ai
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Use 'production' en despliegues reales: deshabilita /docs y /openapi.json.
APP_ENV=production
APP_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE

# Credenciales iniciales del login de la API. Se usan solo la primera vez
# (cuando no existe ningún usuario); después la clave se cambia vía
# POST /api/auth/change-password y el valor de este archivo deja de importar.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Token que Oxidized envía al backend para leer el inventario.
# Genere un valor hexadecimal (openssl rand -hex 32); evite caracteres especiales.
OXIDIZED_SOURCE_TOKEN=CHANGE_ME_OXIDIZED_SOURCE_TOKEN

# El panel se expone con un Nginx Proxy Manager EXTERNO, que no forma parte de
# este repositorio. El puerto solo escucha en localhost: el proxy entra por la
# red Docker compartida, no por la LAN. Ver docs/PUBLIC_ACCESS.md.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
OXIDIZED_BIND_ADDRESS=127.0.0.1
OXIDIZED_PORT=8888

# Red Docker del proxy externo a la que se conecta el backend. La escribe
# `install.sh --proxy <red>`; solo se usa con deploy/docker-compose.proxy.yml.
PROXY_NETWORK=

# En quién confía uvicorn para leer X-Forwarded-For. Con proxy externo, la
# subred de su red Docker (p. ej. 172.18.0.0/16). NUNCA "*": permitiría
# falsificar la IP de origen a cualquiera que alcance el puerto del backend.
FORWARDED_ALLOW_IPS=127.0.0.1

# HSTS. Actívelo solo cuando el dominio y su certificado estén confirmados:
# deja al navegador clavado en HTTPS para ese host durante un año.
APP_ENABLE_HSTS=false

# /health/backups responde 503 si un equipo lleva sin respaldo más de este
# múltiplo de su intervalo. Lo consulta Uptime Kuma.
BACKUP_STALENESS_FACTOR=3

# Directorio que comparten el panel y el anfitrión para el botón "Actualizar".
# Debe coincidir con el que vigila oxidized-ai-manager-updater.path.
UPDATE_CHANNEL_DIR=./.update-channel

# Versión estable con imagen linux/arm64 publicada oficialmente.
OXIDIZED_IMAGE=oxidized/oxidized:0.37.0
