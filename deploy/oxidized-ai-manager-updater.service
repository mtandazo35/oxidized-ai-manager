[Unit]
Description=Aplica la actualización de Oxidized AI Manager pedida desde el panel
After=docker.service
Requires=docker.service
# Si el servicio falla, la unidad .path puede volver a dispararse mientras el
# archivo de petición exista: este freno evita un bucle de arranques.
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
# Ruta canónica: /opt/oxidized-ai-manager. Si el repositorio vive en otra,
# `sudo ./install.sh --systemd` instala estas unidades con la ruta real.
Type=oneshot
WorkingDirectory=/opt/oxidized-ai-manager
Environment=PROJECT_DIR=/opt/oxidized-ai-manager
Environment=CHANNEL_DIR=/opt/oxidized-ai-manager/.update-channel
Environment=UPDATE_BRANCH=main
# Opcional: exigir que origin/main esté firmado (git verify-commit) por una
# clave del llavero de root. Ver docs/UPDATES.md antes de activarlo.
#Environment=UPDATE_REQUIRE_SIGNED=1
# La frase de cifrado del respaldo previo, si la tiene configurada.
EnvironmentFile=-/etc/oxidized-ai-manager-backup.env
ExecStart=/opt/oxidized-ai-manager/scripts/apply-update.sh
# Deja el fallo por escrito y consume la petición, para que el panel no se
# quede colgado en "actualizando…" ni la unidad .path entre en bucle.
ExecStopPost=/opt/oxidized-ai-manager/scripts/update-failed.sh
