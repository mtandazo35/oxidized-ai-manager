# Copie este archivo como .env y cambie todos los valores CHANGE_ME.
# Nunca introduzca secretos reales en Git.
COMPOSE_PROJECT_NAME=oxidized-ai-manager

POSTGRES_DB=oxidized_ai
POSTGRES_USER=oxidized_ai
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE

# Token que Oxidized envía al backend para leer el inventario.
# Genere un valor hexadecimal (openssl rand -hex 32); evite caracteres especiales.
OXIDIZED_SOURCE_TOKEN=CHANGE_ME_OXIDIZED_SOURCE_TOKEN

# Escuche solo en localhost por defecto. Use la IP LAN del host si necesita acceso remoto.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
OXIDIZED_BIND_ADDRESS=127.0.0.1
OXIDIZED_PORT=8888

# Versión estable con imagen linux/arm64 publicada oficialmente.
OXIDIZED_IMAGE=oxidized/oxidized:0.37.0
