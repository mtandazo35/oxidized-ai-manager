---
username: ""
password: ""
model: routeros
interval: 0
debug: false
threads: 1
timeout: 20
timelimit: 60
retries: 1
prompt: !ruby/regexp /^([\w.@-]+[#>]\s?)$/
pid: /tmp/oxidized.pid
crash:
  directory: /home/oxidized/.config/oxidized/crashes
  hostnames: false
vars:
  remove_secret: true
extensions:
  oxidized-web:
    load: true
    listen: 0.0.0.0
    port: 8888
    vhosts:
      - localhost
      - 127.0.0.1
      - oxidized
      - backend
      - 178.156.243.184
input:
  default: ssh
  debug: false
output:
  default: file
  file:
    directory: /home/oxidized/.config/oxidized/configs
source:
  default: http
  http:
    url: http://backend:8000/api/oxidized/nodes
    map:
      name: name
      ip: ip
      model: model
      username: username
      password: password
    headers:
      X-Oxidized-Token: "__OXIDIZED_SOURCE_TOKEN__"
