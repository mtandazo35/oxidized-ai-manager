[Unit]
Description=Vigila las peticiones de actualización que deja el panel

[Path]
# Ruta canónica: /opt/oxidized-ai-manager. Si el repositorio vive en otra,
# `sudo ./install.sh --systemd` instala estas unidades con la ruta real.
# El panel escribe este archivo; systemd despierta al servicio.
PathExists=/opt/oxidized-ai-manager/.update-channel/update-request.json

[Install]
WantedBy=paths.target
