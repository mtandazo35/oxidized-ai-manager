---
username: ""
password: ""
model: routeros
interval: 3600
debug: false
threads: 1
timeout: 20
timelimit: 60
retries: 1
prompt: !ruby/regexp /^([\w.@-]+[#>]\s?)$/
pid: /tmp/oxidized.pid
crash:
  directory: /home/oxidized/.config/oxidized/crashes
  hostnames: false
vars:
  remove_secret: true
extensions:
  oxidized-web:
    load: true
    listen: 0.0.0.0
    port: 8888
    vhosts:
      - localhost
      - 127.0.0.1
      - oxidized
      - backend
      - 178.156.243.184
input:
  default: ssh
  debug: false
output:
  default: git
  git:
    user: oxidized
    email: backup@oxidized-ai-manager.local
    repo: /home/oxidized/.config/oxidized/backups.git
hooks:
  notify-backend:
    type: exec
    events: [node_success, node_fail]
    cmd: 'curl -s -m 10 -X POST -H "X-Oxidized-Token: __OXIDIZED_SOURCE_TOKEN__" -H "Content-Type: application/json" -d "{\"node\":\"$OX_NODE_NAME\",\"event\":\"$OX_EVENT\",\"commit\":\"$OX_REPO_COMMITREF\"}" http://backend:8000/api/oxidized/events'
source:
  default: http
  http:
    url: http://backend:8000/api/oxidized/nodes
    map:
      name: name
      ip: ip
      model: model
      username: username
      password: password
    headers:
      X-Oxidized-Token: "__OXIDIZED_SOURCE_TOKEN__"
